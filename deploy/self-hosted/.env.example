# Copy to .env with scripts/Initialize-Env.ps1. Never commit the generated file.
COMPOSE_PROJECT_NAME=aion2-economy
SITE_PORT=8080

POSTGRES_DB=aion2_economy
POSTGRES_USER=aion2
POSTGRES_PASSWORD=replace-with-a-long-random-value
SESSION_HMAC_KEY_B64=replace-with-base64url-32-random-bytes
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
REGISTRATION_ENABLED=false
WRITE_FENCED=false

# Collector/crawler settings. The TLS keylog and bundles remain on this host.
AION2_HOST_KEYLOG=runtime/private/tls.keys
AION2_CAPTURE_SECONDS=120
AION2_CAPTURE_INTERVAL_SECONDS=5
AION2_SCAN_INTERVAL_SECONDS=3600
AION2_SESSION_MAX_AGE_SECONDS=900
AION2_CLIENT_BUILD=25650019

# Experimental standalone farming tracker. The optional write-only token is
# created from the local site's Farm sessions screen; never commit a real value.
AION2_FARM_PACKET_BUS_ENABLED=false
AION2_FARM_PACKET_BUS=runtime/private/packet-live
AION2_FARM_HISTORY=runtime/state/farm-sessions.sqlite
# Required when the tracker is enabled. Set the exact current character server;
# there is deliberately no cross-server/default fallback for farm valuation.
AION2_FARM_MARKET_SERVER_ID=
AION2_FARM_LISTEN_PORT=8765
AION2_FARM_SYNC_ORIGIN=http://127.0.0.1:8080
AION2_FARM_SYNC_TOKEN=
